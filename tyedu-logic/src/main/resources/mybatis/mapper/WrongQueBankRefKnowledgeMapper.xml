<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ty.logic.sch.dao.WrongQueBankRefKnowledgeDao">
    <!-- 查询结果集 -->
    <select id="findWrongQueBankRefKnowledge" parameterType="java.util.Set" resultType="WrongQueBankRefKnowledge">
        SELECT
            t.qid,
            t.kid,
            t.kname
        FROM
            t_wrong_que_bank_ref_knowledge t
        WHERE
            t.qid IN
        <foreach collection="qids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

    <!-- 批量保存 -->
    <insert id="saveMultiWrongQueBankRefKnowledge" parameterType="java.util.List">
        INSERT INTO t_wrong_que_bank_ref_knowledge(qid, kid, kname)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.qid}, #{item.kid}, #{item.kname})
        </foreach>
    </insert>

    <!-- 删除 -->
    <delete id="delWrongQueBankRefKnowledge" parameterType="java.lang.Integer">
        DELETE FROM t_wrong_que_bank_ref_knowledge WHERE qid = #{qid}
    </delete>
</mapper>
